      "typeVersion": 2,
      "position": [
        -1008,
        -160
      ],
      "id": "23f5fa03-26c1-4429-bbb3-6f3763fb38e5",
      "name": "Fetch Weekly Data"
    },
    {
      "parameters": {
        "jsCode": "const data = $input.first().json;\nconst stats = data.daily_stats;\n\n// Calculate totals and averages\nlet totalRevenue = 0;\nlet totalTickets = 0;\nlet totalUptime = 0;\n\nstats.forEach(day => {\n    totalRevenue += day.sales_revenue;\n    totalTickets += day.support_tickets;\n    totalUptime += day.server_uptime;\n});\n\nconst averageUptime = (totalUptime / stats.length).toFixed(2);\n\nreturn {\n    json: {\n        week_start: data.week_start,\n        total_weekly_revenue: totalRevenue,\n        total_weekly_tickets: totalTickets,\n        average_uptime_percent: averageUptime,\n        raw_daily_breakdown: stats\n    }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -848,
        -160
      ],
      "id": "b079b3d3-7e27-482e-974e-c0bd04d875ca",
      "name": "Calculate Weekly Metrics"
    },
