    {
      "parameters": {
        "jsCode": "return [\n  {\n    json: {\n      \"week_start\": \"2026-08-10\",\n      \"daily_stats\": [\n        { \"day\": \"Monday\", \"sales_revenue\": 4500, \"support_tickets\": 12, \"server_uptime\": 100 },\n        { \"day\": \"Tuesday\", \"sales_revenue\": 5200, \"support_tickets\": 15, \"server_uptime\": 100 },\n        { \"day\": \"Wednesday\", \"sales_revenue\": 1100, \"support_tickets\": 85, \"server_uptime\": 96.5 },\n        { \"day\": \"Thursday\", \"sales_revenue\": 4800, \"support_tickets\": 20, \"server_uptime\": 100 },\n        { \"day\": \"Friday\", \"sales_revenue\": 6100, \"support_tickets\": 10, \"server_uptime\": 100 }\n      ]\n    }\n  }\n];"
      },
