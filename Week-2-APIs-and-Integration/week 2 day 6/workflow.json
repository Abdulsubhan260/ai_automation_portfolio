      "id": "77b04857-1056-494f-8e77-2d1033101076",
      "name": "Validate Incoming Lead"
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nreturn items.map(item => {\n  const body = item.json.body || item.json;\n  const name = body.name || '';\n  const email = body.email || '';\n  const company = body.company || 'N/A';\n  const service = body.service || '';\n  const budget = Number(body.budget) || 0;\n\n  let score = 0;\n\n  // Budget Scoring\n  if (budget >= 10000) {\n    score += 50;\n  } else if (budget >= 5000) {\n    score += 30;\n  } else {\n    score += 10;\n  }\n\n  // Service Interest Scoring\n  const serviceLower = service.toLowerCase();\n  if (serviceLower.includes('ai') || serviceLower.includes('enterprise') || serviceLower.includes('automation')) {\n    score += 30;\n  } else {\n    score += 10;\n  }\n\n  // Priority Segmentation\n  let priority = 'Low Priority';\n  if (score >= 70) {\n    priority = 'High Priority';\n  } else if (score >= 40) {\n    priority = 'Medium Priority';\n  }\n\n  return {\n    json: {\n      name,\n      email,\n      company,\n      service,\n      budget,\n      lead_score: score,\n      priority: priority\n    }\n  };\n});"
      },
