      "parameters": {
        "jsCode": "const items = $input.all();\n\nreturn items.map(item => {\n  const exp = Number(item.json.experience_years) || 0;\n  const skills = (item.json.skills || '').toLowerCase();\n  const degree = (item.json.degree || '').toLowerCase();\n\n  let category = 'Not Eligible';\n  let nextAction = 'Send polite rejection email.';\n\n  // Shortlisting Logic\n  if (exp >= 2 && (skills.includes('n8n') || skills.includes('automation') || skills.includes('python'))) {\n    category = 'Shortlisted';\n    nextAction = 'Schedule technical interview and send invitation email.';\n  } \n  // Needs Review Logic\n  else if (exp >= 1 || skills.includes('n8n') || skills.includes('automation')) {\n    category = 'Needs Review';\n    nextAction = 'Flag for HR manual review and send status update email.';\n  }\n\n  return {\n    json: {\n      ...item.json,\n      category: category,\n      next_action: nextAction\n    }\n  };\n});"
      },
